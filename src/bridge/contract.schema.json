{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract",
  "description": "Export root keeps every boundary type reachable in a single versioned schema.",
  "type": "object",
  "required": [
    "action",
    "failure",
    "lyric_version",
    "product_command",
    "product_reply",
    "snapshot"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/RuntimeAction"
    },
    "failure": {
      "$ref": "#/definitions/CommandFailure"
    },
    "lyric_version": {
      "$ref": "#/definitions/LyricVersion"
    },
    "product_command": {
      "$ref": "#/definitions/ProductCommand"
    },
    "product_reply": {
      "$ref": "#/definitions/ProductReply"
    },
    "snapshot": {
      "$ref": "#/definitions/RuntimeSnapshot"
    }
  },
  "definitions": {
    "Appearance": {
      "type": "object",
      "required": [
        "floating",
        "main",
        "opacity",
        "reducedMotion"
      ],
      "properties": {
        "floating": {
          "$ref": "#/definitions/ReaderAppearance"
        },
        "main": {
          "$ref": "#/definitions/ReaderAppearance"
        },
        "opacity": {
          "type": "number",
          "format": "double"
        },
        "reducedMotion": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "BackupLimits": {
      "type": "object",
      "required": [
        "maxNodes",
        "maxStringBytes"
      ],
      "properties": {
        "maxBytes": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxNodes": {
          "$ref": "#/definitions/Counter"
        },
        "maxStringBytes": {
          "$ref": "#/definitions/Counter"
        }
      },
      "additionalProperties": false
    },
    "BackupProgress": {
      "type": "object",
      "required": [
        "message",
        "stage",
        "summary"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "stage": {
          "$ref": "#/definitions/BackupStage"
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "token": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "BackupStage": {
      "type": "string",
      "enum": [
        "idle",
        "busy",
        "preview",
        "done",
        "failed",
        "cancelling"
      ]
    },
    "Capabilities": {
      "type": "object",
      "required": [
        "libraryAvailable",
        "mode",
        "platform",
        "reason",
        "trackingAvailable"
      ],
      "properties": {
        "libraryAvailable": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/definitions/RuntimeMode"
        },
        "platform": {
          "$ref": "#/definitions/Platform"
        },
        "reason": {
          "type": "string"
        },
        "trackingAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "CommandFailure": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/FailureCode"
        },
        "message": {
          "type": "string"
        },
        "retryAfterMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Counter": {
      "type": "string",
      "format": "uint64-decimal",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "FailureCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "unsupported",
        "permission_denied",
        "offline",
        "rate_limited",
        "storage_unavailable",
        "cancelled"
      ]
    },
    "LibraryDetail": {
      "type": "object",
      "required": [
        "adjustments",
        "item",
        "versions"
      ],
      "properties": {
        "adjustments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VersionAdjustment"
          }
        },
        "item": {
          "$ref": "#/definitions/LibraryItem"
        },
        "selected": {
          "type": [
            "string",
            "null"
          ]
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LyricVersion"
          }
        }
      },
      "additionalProperties": false
    },
    "LibraryItem": {
      "type": "object",
      "required": [
        "favorite",
        "hasLyrics",
        "playCount",
        "recording"
      ],
      "properties": {
        "favorite": {
          "type": "boolean"
        },
        "hasLyrics": {
          "type": "boolean"
        },
        "lastPlayedMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "playCount": {
          "$ref": "#/definitions/Counter"
        },
        "recording": {
          "$ref": "#/definitions/Recording"
        }
      },
      "additionalProperties": false
    },
    "LibraryQuery": {
      "type": "object",
      "required": [
        "favoritesOnly",
        "limit",
        "offset",
        "sort",
        "text"
      ],
      "properties": {
        "favoritesOnly": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sort": {
          "$ref": "#/definitions/LibrarySort"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "LibrarySort": {
      "type": "string",
      "enum": [
        "title",
        "artist",
        "recent",
        "most_played"
      ]
    },
    "LookupStatus": {
      "type": "string",
      "enum": [
        "idle",
        "waiting",
        "loading",
        "ready",
        "offline",
        "not_found",
        "instrumental",
        "insufficient_metadata",
        "failed"
      ]
    },
    "LyricLine": {
      "type": "object",
      "required": [
        "id",
        "text",
        "words"
      ],
      "properties": {
        "endMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "startMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LyricWord"
          }
        }
      },
      "additionalProperties": false
    },
    "LyricOrigin": {
      "type": "string",
      "enum": [
        "provider",
        "import",
        "personal"
      ]
    },
    "LyricVersion": {
      "type": "object",
      "required": [
        "confidence",
        "contentHash",
        "id",
        "lines",
        "origin",
        "recordingId",
        "retention",
        "timing"
      ],
      "properties": {
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/definitions/MatchConfidence"
        },
        "contentHash": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LyricLine"
          }
        },
        "origin": {
          "$ref": "#/definitions/LyricOrigin"
        },
        "providerDurationMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordingId": {
          "type": "string"
        },
        "retention": {
          "type": "string"
        },
        "sourceName": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "timing": {
          "$ref": "#/definitions/TimingKind"
        }
      },
      "additionalProperties": false
    },
    "LyricWord": {
      "type": "object",
      "required": [
        "startMs",
        "text"
      ],
      "properties": {
        "endMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "startMs": {
          "$ref": "#/definitions/Counter"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "MatchConfidence": {
      "type": "string",
      "enum": [
        "confident",
        "uncertain"
      ]
    },
    "OverlayMode": {
      "type": "string",
      "enum": [
        "compact",
        "expanded",
        "minimal"
      ]
    },
    "Platform": {
      "type": "string",
      "enum": [
        "windows",
        "linux",
        "macos"
      ]
    },
    "PlaybackSnapshot": {
      "type": "object",
      "required": [
        "observedAtMs",
        "playerId",
        "playerName",
        "sessionId",
        "status",
        "streamPinAvailable"
      ],
      "properties": {
        "observedAtMs": {
          "$ref": "#/definitions/Counter"
        },
        "playerId": {
          "$ref": "#/definitions/PlayerId"
        },
        "playerName": {
          "type": "string"
        },
        "positionMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "recording": {
          "anyOf": [
            {
              "$ref": "#/definitions/Recording"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/PlaybackStatus"
        },
        "streamPinAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "PlaybackStatus": {
      "type": "string",
      "enum": [
        "playing",
        "paused",
        "buffering",
        "stopped",
        "unknown"
      ]
    },
    "PlayerId": {
      "type": "object",
      "required": [
        "nativeId",
        "platform"
      ],
      "properties": {
        "nativeId": {
          "type": "string"
        },
        "platform": {
          "$ref": "#/definitions/Platform"
        }
      },
      "additionalProperties": false
    },
    "PlayerInfo": {
      "type": "object",
      "required": [
        "available",
        "enabled",
        "id",
        "name"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/definitions/PlayerId"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ProductCommand": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "limits"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "backup_preview"
              ]
            },
            "limits": {
              "$ref": "#/definitions/BackupLimits"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "settings",
            "token"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "backup_apply"
              ]
            },
            "settings": {
              "type": "boolean"
            },
            "token": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "limits"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "backup_export"
              ]
            },
            "limits": {
              "$ref": "#/definitions/BackupLimits"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "backup_poll"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "backup_cancel"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "diagnostics_preview"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "diagnostics_export"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "current_detail"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "hide_overlay"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "query"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "library"
              ]
            },
            "query": {
              "$ref": "#/definitions/LibraryQuery"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "detail"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "value"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "favorite"
              ]
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action",
            "kind"
          ],
          "properties": {
            "action": {
              "$ref": "#/definitions/ReaderAction"
            },
            "kind": {
              "type": "string",
              "enum": [
                "reader"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "appearance"
              ]
            },
            "value": {
              "$ref": "#/definitions/Appearance"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "reset_appearance"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "query"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "search"
              ]
            },
            "query": {
              "$ref": "#/definitions/SearchQuery"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "token"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "search_poll"
              ]
            },
            "token": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "context",
            "kind"
          ],
          "properties": {
            "context": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "search_cancel"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "token",
            "versionId"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "save_search"
              ]
            },
            "token": {
              "type": "string"
            },
            "versionId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "clear_downloads"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "clear_history"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "mode"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "overlay"
              ]
            },
            "mode": {
              "$ref": "#/definitions/OverlayMode"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "enabled",
            "kind"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "enum": [
                "click_through"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "side"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "dock"
              ]
            },
            "side": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "reset_overlay"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "open_releases"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ProductReply": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "state"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "backup"
              ]
            },
            "state": {
              "$ref": "#/definitions/BackupProgress"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "report"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "diagnostics"
              ]
            },
            "report": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "done"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "items",
            "kind",
            "more"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/LibraryItem"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "library"
              ]
            },
            "more": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "detail",
            "kind"
          ],
          "properties": {
            "detail": {
              "$ref": "#/definitions/LibraryDetail"
            },
            "kind": {
              "type": "string",
              "enum": [
                "detail"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "message",
            "status",
            "token",
            "versions"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "search"
              ]
            },
            "message": {
              "type": "string"
            },
            "status": {
              "$ref": "#/definitions/LookupStatus"
            },
            "token": {
              "type": "string"
            },
            "versions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/LyricVersion"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ReaderAction": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "versionId"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "select"
              ]
            },
            "versionId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
