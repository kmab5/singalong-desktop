{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract",
  "description": "Export root keeps every boundary type reachable in a single versioned schema.",
  "type": "object",
  "required": [
    "action",
    "failure",
    "lyric_version",
    "snapshot"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/RuntimeAction"
    },
    "failure": {
      "$ref": "#/definitions/CommandFailure"
    },
    "lyric_version": {
      "$ref": "#/definitions/LyricVersion"
    },
    "snapshot": {
      "$ref": "#/definitions/RuntimeSnapshot"
    }
  },
  "definitions": {
    "Capabilities": {
      "type": "object",
      "required": [
        "libraryAvailable",
        "mode",
        "platform",
        "reason",
        "trackingAvailable"
      ],
      "properties": {
        "libraryAvailable": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/definitions/RuntimeMode"
        },
        "platform": {
          "$ref": "#/definitions/Platform"
        },
        "reason": {
          "type": "string"
        },
        "trackingAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "CommandFailure": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/FailureCode"
        },
        "message": {
          "type": "string"
        },
        "retryAfterMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Counter": {
      "type": "string",
      "format": "uint64-decimal",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "FailureCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "unsupported",
        "permission_denied",
        "offline",
        "rate_limited",
        "storage_unavailable",
        "cancelled"
      ]
    },
    "LookupStatus": {
      "type": "string",
      "enum": [
        "idle",
        "waiting",
        "loading",
        "ready",
        "offline",
        "not_found",
        "instrumental",
        "insufficient_metadata",
        "failed"
      ]
    },
    "LyricLine": {
      "type": "object",
      "required": [
        "id",
        "text",
        "words"
      ],
      "properties": {
        "endMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "startMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LyricWord"
          }
        }
      },
      "additionalProperties": false
    },
    "LyricOrigin": {
      "type": "string",
      "enum": [
        "provider",
        "import",
        "personal"
      ]
    },
    "LyricVersion": {
      "type": "object",
      "required": [
        "confidence",
        "contentHash",
        "id",
        "lines",
        "origin",
        "recordingId",
        "retention",
        "timing"
      ],
      "properties": {
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/definitions/MatchConfidence"
        },
        "contentHash": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LyricLine"
          }
        },
        "origin": {
          "$ref": "#/definitions/LyricOrigin"
        },
        "providerDurationMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordingId": {
          "type": "string"
        },
        "retention": {
          "type": "string"
        },
        "sourceName": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "timing": {
          "$ref": "#/definitions/TimingKind"
        }
      },
      "additionalProperties": false
    },
    "LyricWord": {
      "type": "object",
      "required": [
        "startMs",
        "text"
      ],
      "properties": {
        "endMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "startMs": {
          "$ref": "#/definitions/Counter"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "MatchConfidence": {
      "type": "string",
      "enum": [
        "confident",
        "uncertain"
      ]
    },
    "Platform": {
      "type": "string",
      "enum": [
        "windows",
        "linux",
        "macos"
      ]
    },
    "PlaybackSnapshot": {
      "type": "object",
      "required": [
        "observedAtMs",
        "playerId",
        "playerName",
        "sessionId",
        "status",
        "streamPinAvailable"
      ],
      "properties": {
        "observedAtMs": {
          "$ref": "#/definitions/Counter"
        },
        "playerId": {
          "$ref": "#/definitions/PlayerId"
        },
        "playerName": {
          "type": "string"
        },
        "positionMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "recording": {
          "anyOf": [
            {
              "$ref": "#/definitions/Recording"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/PlaybackStatus"
        },
        "streamPinAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "PlaybackStatus": {
      "type": "string",
      "enum": [
        "playing",
        "paused",
        "buffering",
        "stopped",
        "unknown"
      ]
    },
    "PlayerId": {
      "type": "object",
      "required": [
        "nativeId",
        "platform"
      ],
      "properties": {
        "nativeId": {
          "type": "string"
        },
        "platform": {
          "$ref": "#/definitions/Platform"
        }
      },
      "additionalProperties": false
    },
    "PlayerInfo": {
      "type": "object",
      "required": [
        "available",
        "enabled",
        "id",
        "name"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/definitions/PlayerId"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ReaderState": {
      "type": "object",
      "required": [
        "cached",
        "message",
        "positionAvailable",
        "status"
      ],
      "properties": {
        "activeLine": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 19999,
          "minimum": 0
        },
        "cached": {
          "type": "boolean"
        },
        "countdownSeconds": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "positionAvailable": {
          "type": "boolean"
        },
        "retryAfterMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/definitions/LookupStatus"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/definitions/LyricVersion"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Recording": {
      "type": "object",
      "required": [
        "artists",
        "id",
        "title"
      ],
      "properties": {
        "album": {
          "type": [
            "string",
            "null"
          ]
        },
        "artists": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "durationMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "fileName": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "versionLabel": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RuntimeAction": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "visible"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "show_overlay"
              ]
            },
            "visible": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "enabled",
            "kind"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "enum": [
                "reader_active"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "enabled",
            "kind"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "enum": [
                "offline"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "retry_lyrics"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "enabled",
            "kind"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "enum": [
                "tracking"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "enabled",
            "kind",
            "playerId"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "enum": [
                "enable_player"
              ]
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "mode"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "select"
              ]
            },
            "mode": {
              "$ref": "#/definitions/SelectionMode"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "discover"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "enabled",
            "kind"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "enum": [
                "startup"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "enabled",
            "kind"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "enum": [
                "auto_overlay"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "close_to_tray"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "quit"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RuntimeMode": {
      "type": "string",
      "enum": [
        "native",
        "fixture"
      ]
    },
    "RuntimeSnapshot": {
      "type": "object",
      "required": [
        "autoOverlay",
        "capabilities",
        "closeNotice",
        "generation",
        "offline",
        "overlayVisible",
        "players",
        "reader",
        "revision",
        "schema",
        "selection",
        "sessions",
        "startAtSignIn",
        "statusMessage",
        "trackingEnabled"
      ],
      "properties": {
        "autoOverlay": {
          "type": "boolean"
        },
        "capabilities": {
          "$ref": "#/definitions/Capabilities"
        },
        "closeNotice": {
          "type": "boolean"
        },
        "generation": {
          "$ref": "#/definitions/Counter"
        },
        "offline": {
          "type": "boolean"
        },
        "overlayVisible": {
          "type": "boolean"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlayerInfo"
          }
        },
        "reader": {
          "$ref": "#/definitions/ReaderState"
        },
        "revision": {
          "$ref": "#/definitions/Counter"
        },
        "schema": {
          "type": "integer",
          "format": "uint8",
          "maximum": 1,
          "minimum": 1
        },
        "selectedSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection": {
          "$ref": "#/definitions/SelectionMode"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlaybackSnapshot"
          }
        },
        "startAtSignIn": {
          "type": "boolean"
        },
        "statusMessage": {
          "type": "string"
        },
        "trackingEnabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "SelectionMode": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "automatic"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "playerId"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "app_pin"
              ]
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "playerId",
            "sessionId"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "stream_pin"
              ]
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            },
            "sessionId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "TimingKind": {
      "type": "string",
      "enum": [
        "supplied",
        "unsynced"
      ]
    }
  }
}
